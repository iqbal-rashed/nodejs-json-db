{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "checkJs": true,
        "allowJs": true,
        "declaration": true,
        "declarationMap": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["ES6"],
        "target": "ES6",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "declarationDir": "./lib/types"
    },
    "include": ["src"]
}
