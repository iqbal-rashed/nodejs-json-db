{
  "name": "nodejs-json-db",
  "version": "1.0.0",
  "description": "A production-ready, lightweight JSON-based database for Node.js and Electron applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "benchmark": "tsx examples/benchmark.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iqbal-rashed/nodejs-json-db.git"
  },
  "keywords": [
    "json",
    "database",
    "db",
    "nosql",
    "document",
    "storage",
    "electron",
    "nodejs",
    "typescript",
    "esm",
    "cjs",
    "lightweight",
    "file-based",
    "local-storage"
  ],
  "author": "Rashed Iqbal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iqbal-rashed/nodejs-json-db/issues"
  },
  "homepage": "https://github.com/iqbal-rashed/nodejs-json-db#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^4.0.16",
    "zod": "^4.2.1"
  },
  "dependencies": {
    "bson": "^7.0.0"
  },
  "optionalDependencies": {
    "zod": "^3.0.0 || ^4.0.0"
  }
}
